
#include <stdio.h>

int main()
{
    int price, qty, senior;
    int total, net;
    int count = 5;

    price = 100;
    qty = 2;
    senior = 1;

    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = total > 1000 ? total - 50 : total;

    printf("Total = %d\n", total);
    printf("Net amount = %d\n", net);

    price = 250;
    qty = 5;
    senior = 0;

    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = total > 1000 ? total - 50 : total;

    printf("\nTotal = %d\n", total);
    printf("Net amount = %d\n", net);

    price = 999;
    qty = 1;
    senior = 1;

    total = price * qty - price * qty * 15 / 100 * senior
            + price * qty * 5 / 100;

    net = total > 1000 ? total - 50 : total;

    printf("\nTotal = %d\n", total);
    printf("Net amount = %d\n", net);

    printf("\nCount = %d\n", count);

    return 0;
}
