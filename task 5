
#include <stdio.h>

unsigned long checks;

int prime_for(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    for (unsigned long i = 2; i * i <= n; i++)
    {
        checks++;

        if (n % i == 0)
            return 0;
    }

    return 1;
}

int prime_while(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    unsigned long i = 2;

    while (i * i <= n)
    {
        checks++;

        if (n % i == 0)
            return 0;

        i++;
    }

    return 1;
}

int prime_do(unsigned long n)
{
    checks = 0;

    if (n < 2)
        return 0;

    unsigned long i = 2;

    do
    {
        if (i * i > n)
            break;

        checks++;

        if (n % i == 0)
            return 0;

        i++;

    } while (i * i <= n);

    return 1;
}

int main()
{
    unsigned long numbers[] = {97, 100, 7919, 1000003};

    for (int i = 0; i < 4; i++)
    {
        int result = prime_for(numbers[i]);

        printf("%lu: %s, divisions = %lu\n",
               numbers[i],
               result ? "prime" : "not prime",
               checks);
    }

    return 0;
}
