
#include <stdio.h>

int calls = 0;

int verify_card(int i)
{
    calls++;
    return (i % 10 == 0);
}

int main()
{
    int senior, eligible;
    int result;
    int i;

    /* Condition A first */
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i % 5 == 0);
        eligible = (i % 2 == 0);

        result = (senior && eligible) || verify_card(i);
    }

    printf("A first: %d calls\n", calls);

    /* Verification first */
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i % 5 == 0);
        eligible = (i % 2 == 0);

        result = verify_card(i) || (senior && eligible);
    }

    printf("Verification first: %d calls\n", calls);

    /* Bitwise OR */
    calls = 0;

    for (i = 0; i < 1000; i++)
    {
        senior = (i % 5 == 0);
        eligible = (i % 2 == 0);

        result = (senior && eligible) | verify_card(i);
    }

    printf("Bitwise OR: %d calls\n", calls);

    return 0;
}
